{
  "name": "crm-tumi", "private": true, "version": "0.1.0",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB,MAIL \"npm run dev -w @tumi/api\" \"npm run dev -w @tumi/web\" \"npm run worker:dev -w @tumi/api\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w @tumi/api",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @tumi/api",
    "db:migrate": "npm run db:migrate -w @tumi/api",
    "admin:create": "npm run admin:create -w @tumi/api"
  },
  "overrides": { "deepmerge-ts": "^8.0.0", "exceljs": { "uuid": "^11.1.1" } },
  "devDependencies": { "concurrently": "^9.2.0", "@playwright/test": "^1.56.0" }
}
