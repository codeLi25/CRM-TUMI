NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://tumi:CHANGE_ME@127.0.0.1:3306/crm_tumi
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=El Tumi <no-reply@tumi.test>
# Optional for authenticated SMTP:
SMTP_USER=
SMTP_PASSWORD=
# preview: guarda los correos de campañas en MySQL, sin enviarlos.
# smtp: usa el proveedor configurado arriba. API y worker deben usar el mismo modo.
CAMPAIGN_MAIL_MODE=preview
# resend: API de Resend. Requiere dominio verificado; desarrollo admite localhost. Producción exige APP_ORIGIN público HTTPS.
# Guardar el secreto exclusivamente en backend/.env (ignorado por Git).
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
# Ruta persistente; relativa al directorio backend al ejecutar con npm.
UPLOAD_DIR=.local/uploads
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
